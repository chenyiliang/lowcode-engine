{
  "name": "@alilc/lowcode-editor-core",
  "version": "1.3.2",
  "description": "Core Api for Ali lowCode engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "classnames": "^2.5.1",
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "intl-messageformat": "^12.1.3",
    "lodash": "^4.18.1",
    "power-di": "^2.4.57",
    "reflect-metadata": "^0.2.2",
    "store": "^2.0.12",
    "strict-event-emitter-types": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/store": "^2.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "less": "^4.9.1",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "http",
    "url": "https://github.com/alibaba/lowcode-engine/tree/main/packages/editor-core"
  },
  "gitHead": "2669f179e6f899d395ce1942d0fe04f9c5ed48a6",
  "bugs": "https://github.com/alibaba/lowcode-engine/issues",
  "homepage": "https://github.com/alibaba/lowcode-engine/#readme"
}
