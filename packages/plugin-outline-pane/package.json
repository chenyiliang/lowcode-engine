{
  "name": "@alilc/lowcode-plugin-outline-pane",
  "version": "1.3.2",
  "description": "Outline pane plugin for Ali lowCode engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "classnames": "^2.5.1",
    "events": "^3.3.0",
    "ric-shim": "^1.0.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "less": "^4.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "http",
    "url": "https://github.com/alibaba/lowcode-engine/tree/main/packages/plugin-outline-pane"
  },
  "gitHead": "2669f179e6f899d395ce1942d0fe04f9c5ed48a6",
  "bugs": "https://github.com/alibaba/lowcode-engine/issues",
  "homepage": "https://github.com/alibaba/lowcode-engine/#readme"
}
