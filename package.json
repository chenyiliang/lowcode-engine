{
  "name": "ali-lowcode-engine-monorepo",
  "version": "1.3.2",
  "private": true,
  "description": "Ali LowCode Engine (React 19 + Vite)",
  "repository": "git@github.com:alibaba/lowcode-engine.git",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./modules/*\" build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:modules": "pnpm --filter \"./modules/*\" build",
    "clean": "pnpm --filter \"./packages/*\" --filter \"./modules/*\" --parallel clean",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./modules/*\" --parallel typecheck",
    "test": "pnpm --filter \"./packages/*\" --filter \"./modules/*\" --parallel test"
  },
  "devDependencies": {
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
