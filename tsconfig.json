{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true
  },
  "include": ["packages/*/src", "modules/*/src"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/lib",
    "**/es",
    "**/build",
    "**/tests",
    "**/test",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
