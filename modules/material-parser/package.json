{
  "name": "@alilc/lowcode-material-parser",
  "version": "1.0.3",
  "description": "物料解析模块 for Ali lowCode engine（Node 库，CommonJS 产物）",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^6.15.0",
    "ast-types": "^0.14.2",
    "cross-spawn-promise": "^0.10.2",
    "debug": "^4.4.3",
    "find-config": "^1.0.0",
    "fs-extra": "^11.3.2",
    "lodash": "^4.18.1",
    "parse-prop-types": "^0.3.0",
    "prop-types": "^15.8.1",
    "react-docgen": "^5.4.3",
    "react-docgen-typescript": "^1.22.0",
    "safe-eval": "^0.4.1",
    "short-uuid": "^3.1.1",
    "ts-polyfill": "^3.8.2",
    "typescript": "^6.0.3",
    "vm2": "^3.12.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.9.2",
    "@types/prop-types": "^15.7.15",
    "jest": "^30.2.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "http",
    "url": "https://github.com/alibaba/lowcode-engine/tree/main/modules/material-parser"
  },
  "bugs": "https://github.com/alibaba/lowcode-engine/issues",
  "homepage": "https://github.com/alibaba/lowcode-engine/#readme"
}
