{
  "name": "@alilc/lowcode-code-generator",
  "version": "1.1.7",
  "description": "出码模块 for Ali lowCode engine（Node/CLI 库，CommonJS 产物）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.mjs",
      "require": "./dist/standalone.js"
    },
    "./standalone-loader": {
      "types": "./dist/standalone-loader.d.ts",
      "import": "./dist/standalone-loader.mjs",
      "require": "./dist/standalone-loader.js"
    },
    "./standalone-worker": {
      "types": "./dist/standalone-worker.d.ts",
      "require": "./dist/standalone-worker.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "require": "./dist/cli.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "lowcode-code-generator": "bin/lowcode-code-generator.js"
  },
  "files": [
    "bin",
    "dist",
    "static-files",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md",
    "example-schema.json",
    "example-schema.json5"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build && pnpm run build:worker",
    "build:lib": "vite build",
    "build:worker": "vite build --config vite.config.worker.ts",
    "build:worker:min": "vite build --config vite.config.worker.ts --minify",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "license": "MIT",
  "dependencies": {
    "@alilc/lowcode-types": "workspace:*",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "buffer": "^6.0.3",
    "chalk": "^4.1.2",
    "change-case": "^3.1.0",
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "file-saver": "^2.0.5",
    "fp-ts": "^2.16.11",
    "fs-extra": "^11.3.2",
    "glob": "^7.2.3",
    "json5": "^2.2.3",
    "jsonc": "^3.0.0",
    "jszip": "^3.10.2",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "nanomatch": "^1.2.13",
    "prettier": "^2.8.8",
    "semver": "^7.8.5",
    "short-uuid": "^6.0.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@iceworks/spec": "^1.6.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/debug": "^4.1.13",
    "@types/file-saver": "^2.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24.9.2",
    "@types/qs": "^6.14.0",
    "@types/semver": "^7.8.0",
    "jest": "^30.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "http",
    "url": "https://github.com/alibaba/lowcode-engine/tree/main/modules/code-generator"
  },
  "bugs": "https://github.com/alibaba/lowcode-engine/issues",
  "homepage": "https://github.com/alibaba/lowcode-engine/#readme"
}
