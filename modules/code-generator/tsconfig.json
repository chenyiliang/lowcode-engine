{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // code-generator 是 Node/CLI 库：ES2022 + Node 类型，不需要 DOM
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["./tests", "tests/fixtures/test-cases", "node_modules", "**/dist", "**/lib", "**/es"]
}
